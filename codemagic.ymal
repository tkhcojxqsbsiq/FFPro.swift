workflows:
  ios-native-workflow:
    name: iOS Native Workflow
    max_build_duration: 60
    instance_type: mac_mini_m1
    environment:
      xcode: latest
      cocoapods: default
    triggering:
      events:
        - push
    scripts:
      - name: Build App
        script: | 
          xcodebuild build -project "FFMenu.xcodeproj" -scheme "FFMenu" -sdk iphoneos -configuration Release CODE_SIGNING_ALLOWED=NO
    artifacts:
      - build/ios/outputs/bundle/*.ipa
